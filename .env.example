# BRANDGUARD CONFIGURATION ENVIRONMENT TEMPLATE

# Core Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
SECRET_KEY=replace_with_a_secure_random_key_for_production

# FastAPI Port
PORT=8000
HOST=0.0.0.0

# Database Configuration (Postgres + pgvector)
POSTGRES_USER=brandguard_admin
POSTGRES_PASSWORD=brandguard_secure_password_123
POSTGRES_DB=brandguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM APIs (Optional - for 'Ask BrandGuard' RAG search)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ML Configuration
MODEL_DEVICE=cpu
MODEL_CACHE_DIR=./models/cache
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
SUMMARIZER_MODEL_NAME=facebook/bart-large-cnn

# JIRA Configuration
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AXIS
JIRA_ENABLED=false
